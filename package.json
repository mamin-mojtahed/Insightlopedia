{
  "name": "insightlopedia",
  "version": "1.0.0",
  "private": true,
  "description": "Insightlopedia - The Comprehensive Insight Encyclopedia Project",
  "workspaces": [
    "backend",
    "app"
  ],
  "scripts": {
    "start": "concurrently -n \"API,APP\" -c \"blue,magenta\" \"npm start --workspace=backend\" \"npm start --workspace=app\"",
    "dev": "concurrently -n \"API,APP\" -c \"blue,magenta\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=app\"",
    "add-quote": "node backend/cli.js",
    "delete-quote": "node backend/deleteQuote.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

